# Copy this file to .env for local development: cp .env.example .env
# .env is read by the React dev server only. Do NOT put Edgify tokens or
# MQTT passwords here: those are entered in the app's Settings screen.

# Port for the React dev server (must match the "dev" script in package.json)
PORT=3001

# Don't open a browser tab; the Electron window loads the dev server instead
BROWSER=none
